+// Bound recursive walkers, including callers passing a prebuilt AST.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  const seen = new Set();
+  while (pending.length) {
+    const [node, depth] = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (depth > 100 || seen.has(node) || seen.size >= 20000) {
+      throw new SyntaxError('Brace AST exceeds safe depth or size');
+    }
+    seen.add(node);
+    if (Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
